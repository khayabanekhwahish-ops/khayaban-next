# Create a free project at https://www.sanity.io/manage, then fill these in.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-06-01

# Only needed to run scripts/migrate-to-sanity.js (one-time content import).
# Create this token at https://www.sanity.io/manage -> your project -> API -> Tokens -> Add API token (Editor permissions).
# Never commit this value.
SANITY_WRITE_TOKEN=
